{
  "name": "yogal-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "type-check": "bunx tsc --noEmit",
    "db:generate": "bunx prisma generate --schema=src/prisma/schema.prisma",
    "db:migrate": "bunx prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:seed": "bun run src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.0"
  }
}
